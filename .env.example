# ─────────────────────────────────────────────────────────────
# Cognitive Dark V2 — Environment Variables
# Copy to `.env` and fill in. NONE of these are committed.
# ─────────────────────────────────────────────────────────────

# ── Script generation ──
GROQ_API_KEY=                       # required — https://console.groq.com
GEMINI_API_KEY=                     # optional fallback — https://aistudio.google.com

# ── Stock video clips ──
PEXELS_API_KEY=                     # free — https://www.pexels.com/api/
PIXABAY_API_KEY=                    # free — https://pixabay.com/api/docs/

# ── Voice ──
TTS_PRIMARY=kokoro                  # kokoro | edge | elevenlabs
KOKORO_VOICE=am_fenrir              # am_fenrir | am_onyx | am_michael (deep male)
KOKORO_SPEED=1.08                  # USA style: punchy & fast (0.98 = slow & dramatic)
VOICE_STYLE=usa
ELEVENLABS_API_KEY=                 # optional premium fallback
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── YouTube upload (OAuth 2.0) ──
# Option A: path to a local credentials JSON
YOUTUBE_CREDENTIALS=data/youtube_credentials.json
# Option B (GitHub Actions): set the secret to the RAW JSON string — the
# system auto-detects and writes it to a temp file.

# ── Facebook (Graph API) ──
FB_PAGE_ID=                         # your Facebook Page numeric ID
FB_ACCESS_TOKEN=                    # long-lived Page token (publish_video, pages_manage_posts)
# FB_REELS_ENDPOINT=video_reels      # optional: use /video_reels instead of /videos

# ── Instagram (Graph API — Business/Creator account linked to the Page) ──
IG_BUSINESS_ACCOUNT_ID=             # /me/accounts → ig user id (instagram_business_account)
IG_ACCESS_TOKEN=                    # same long-lived token (needs instagram_content_publish)
# Optional public hosting for IG container flow (video_url). If unset, the
# system tries the resumable rupload flow instead.
# IG_VIDEO_URL_BASE=https://your-cdn.example.com

# ── Scheduler / ML ──
CD_TIMEZONE=America/New_York
CD_DRY_RUN=0                        # 1 = build everything but never call upload APIs
MIN_POST_GAP_HOURS=6
VIDEO_HISTORY_PATH=data/video_history.json

# ── Meta policy safeguards ──
# Keep captions relevant and concise; do not use engagement bait.
META_MAX_HASHTAGS=5
META_ALLOW_ENGAGEMENT_BAIT=0
ALLOW_UNSAFE_PUBLISH=0              # warn/off remain audit-only by default
CD_OUTPUT_DIR=output
CD_DATA_DIR=data

# ── Music ──
MUSIC_VOLUME=0.05
MUSIC_TRACK=                        # optional: exact filename in assets/music
