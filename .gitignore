# runtime data (never commit secrets/output)
.env
output/
data/tmp/
data/models/
data/clips/
__pycache__/
*.pyc
*.mp4
*.wav

# keep the ML learning store + journal + history (they ARE the memory)
!data/learning_store.json
!data/run_journal.json
!data/video_history.json
!data/monetization_progress.json
data/*.bak

# keep music assets
!assets/music/
# V2.1: re-include generated tracks. V2's `*.wav` rule above silently blocked
# these from ever being committed (a directory re-include alone doesn't
# un-ignore files matched by an extension rule).
!assets/music/*.wav
!assets/music/*.mp3
!data/llm_state.json


# Audit and diagnostic dumps (avoid git bloat)
data/*audit*
data/*diag*
